arr = [10, 5, 2, 7, 1, 9]
k = 15

min_len = float('inf')
cum_sum = 0
cum_sum_map = {}

for i in range(len(arr)):
    cum_sum += arr[i]

    if cum_sum == k:
        min_len = min(min_len, i + 1)

    if cum_sum - k in cum_sum_map:
        length = i - cum_sum_map[cum_sum - k]
        min_len = min(min_len, length)

    cum_sum_map[cum_sum] = i

print(min_len if min_len != float('inf') else 0)